{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account, economy state, inventory, and combat ratings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth user ID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 64
        },
        "email": {
          "type": "string",
          "description": "User Google email address",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "User Google avatar image URL",
          "maxLength": 512
        },
        "gold": {
          "type": "number",
          "description": "Gold coins in player treasury"
        },
        "ownedPieceTypes": {
          "type": "array",
          "description": "List of unlocked piece sets"
        },
        "activePieceType": {
          "type": "string",
          "description": "Currently equipped piece set",
          "maxLength": 64
        },
        "ownedPieceSkins": {
          "type": "array",
          "description": "List of unlocked piece material finishes"
        },
        "activePieceSkin": {
          "type": "string",
          "description": "Currently equipped piece finish",
          "maxLength": 64
        },
        "ownedBoardSkins": {
          "type": "array",
          "description": "List of unlocked board styles"
        },
        "activeBoardSkin": {
          "type": "string",
          "description": "Currently equipped board style",
          "maxLength": 64
        },
        "ownedSceneries": {
          "type": "array",
          "description": "List of unlocked world sceneries"
        },
        "activeScenery": {
          "type": "string",
          "description": "Currently equipped world scenery",
          "maxLength": 64
        },
        "wins": {
          "type": "number",
          "description": "Total chess match victories"
        },
        "captures": {
          "type": "number",
          "description": "Total enemy pieces destroyed"
        },
        "totalGoldEarned": {
          "type": "number",
          "description": "Lifetime gold coins earned"
        },
        "rating": {
          "type": "number",
          "description": "Player ELO skill rating"
        },
        "rankTier": {
          "type": "string",
          "description": "Player rank tier identifier",
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last sync"
        }
      },
      "required": ["userId", "gold", "activePieceType", "wins"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public leaderboard record displaying rank tier and match stats",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth user ID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name of player",
          "maxLength": 64
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL",
          "maxLength": 512
        },
        "wins": {
          "type": "number",
          "description": "Total victories"
        },
        "captures": {
          "type": "number",
          "description": "Total piece captures"
        },
        "rating": {
          "type": "number",
          "description": "ELO rating"
        },
        "rankTier": {
          "type": "string",
          "description": "Tier id: bronze, silver, gold, platinum, or obsidian",
          "maxLength": 32
        },
        "rankNumeral": {
          "type": "string",
          "description": "Roman numeral for tier",
          "maxLength": 8
        },
        "activePieceType": {
          "type": "string",
          "description": "Equipped piece set name or id",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity timestamp"
        }
      },
      "required": ["userId", "displayName", "wins", "rating", "rankTier"]
    },
    "MatchmakingTicket": {
      "title": "MatchmakingTicket",
      "description": "Active online matchmaking queue ticket for cross-device pairing",
      "type": "object",
      "properties": {
        "playerToken": { "type": "string", "maxLength": 128 },
        "preferredColor": { "type": "string", "maxLength": 8 },
        "rating": { "type": "number" },
        "status": { "type": "string", "maxLength": 32 },
        "roomCode": { "type": "string", "maxLength": 16 },
        "assignedColor": { "type": "string", "maxLength": 4 },
        "opponentRating": { "type": "number" },
        "loadoutJson": { "type": "string" },
        "joinedAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["playerToken", "preferredColor", "rating", "status", "updatedAt"]
    },
    "MultiplayerRoom": {
      "title": "MultiplayerRoom",
      "description": "Live multiplayer chess room state synchronized across devices",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "maxLength": 32 },
        "whiteToken": { "type": "string", "maxLength": 128 },
        "blackToken": { "type": "string", "maxLength": 128 },
        "whiteJoined": { "type": "boolean" },
        "blackJoined": { "type": "boolean" },
        "whiteLoadoutJson": { "type": "string" },
        "blackLoadoutJson": { "type": "string" },
        "turn": { "type": "string", "maxLength": 4 },
        "movesJson": { "type": "string" },
        "resetCount": { "type": "number" },
        "surrenderedBy": { "type": "string", "maxLength": 4 },
        "updatedAt": { "type": "number" }
      },
      "required": ["code", "status", "turn", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile, inventory, and stats"
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public player ranking data for the live leaderboard feed"
    },
    "/matchmaking_queue/{ticketId}": {
      "schema": { "$ref": "#/entities/MatchmakingTicket" },
      "description": "Global cross-device matchmaking queue"
    },
    "/multiplayer_rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/MultiplayerRoom" },
      "description": "Global cross-device multiplayer rooms"
    }
  }
}
