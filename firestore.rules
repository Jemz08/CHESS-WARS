rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.gold is number && data.gold >= 0 &&
             data.activePieceType is string && data.activePieceType.size() <= 64 &&
             data.wins is number && data.wins >= 0;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
             data.wins is number && data.wins >= 0 &&
             data.rating is number &&
             data.rankTier is string && data.rankTier.size() <= 32;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Private User Profiles & Economy Progress
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Public Live Leaderboard
    match /leaderboard/{userId} {
      allow read: if isValidId(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidLeaderboardEntry(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidLeaderboardEntry(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
