rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.gold is number && data.gold >= 0 &&
             data.activePieceType is string && data.activePieceType.size() <= 64 &&
             data.wins is number && data.wins >= 0;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
             data.wins is number && data.wins >= 0 &&
             data.rating is number &&
             data.rankTier is string && data.rankTier.size() <= 32;
    }

    function isValidMatchmakingTicket(data) {
      return data.playerToken is string && data.playerToken.size() > 0 && data.playerToken.size() <= 128 &&
             data.preferredColor is string && data.preferredColor.size() <= 8 &&
             data.rating is number &&
             data.status is string && data.status.size() <= 32 &&
             data.updatedAt is number;
    }

    function isValidMultiplayerRoom(data) {
      return data.code is string && data.code.size() > 0 && data.code.size() <= 16 &&
             data.status is string && data.status.size() <= 32 &&
             data.turn is string && data.turn.size() <= 4 &&
             data.updatedAt is number;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Private User Profiles & Economy Progress
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Public Live Leaderboard
    match /leaderboard/{userId} {
      allow get: if isValidId(userId);
      allow list: if existing().rating is number;
      allow create: if isValidId(userId) && isOwner(userId) && isValidLeaderboardEntry(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidLeaderboardEntry(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Global Cross-Device Matchmaking Queue
    match /matchmaking_queue/{ticketId} {
      allow get: if isValidId(ticketId);
      allow list: if existing().updatedAt is number;
      allow create: if isValidId(ticketId) && isValidMatchmakingTicket(incoming());
      allow update: if isValidId(ticketId) && isValidMatchmakingTicket(incoming());
      allow delete: if isValidId(ticketId);
    }

    // Global Cross-Device Multiplayer Rooms
    match /multiplayer_rooms/{roomCode} {
      allow get: if isValidId(roomCode);
      allow list: if existing().updatedAt is number;
      allow create: if isValidId(roomCode) && isValidMultiplayerRoom(incoming());
      allow update: if isValidId(roomCode) && isValidMultiplayerRoom(incoming());
      allow delete: if isValidId(roomCode);
    }
  }
}
