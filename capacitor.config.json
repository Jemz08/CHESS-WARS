{
  "appId": "com.gothicsanctum.wizardchess",
  "appName": "Wizard Chess: Gothic Sanctum",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#07090e",
  "android": {
    "backgroundColor": "#07090e",
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#07090e",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#07090e",
      "overlaysWebView": true
    }
  }
}
