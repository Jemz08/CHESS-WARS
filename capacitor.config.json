{
  "appId": "com.gothicsanctum.wizardchess",
  "appName": "Wizard Chess: Gothic Sanctum",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#F5ECD9",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.googleapis.com",
      "*.firebaseapp.com",
      "*.google.com"
    ]
  },
  "android": {
    "backgroundColor": "#F5ECD9",
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#F5ECD9",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F5ECD9",
      "overlaysWebView": true
    }
  }
}
